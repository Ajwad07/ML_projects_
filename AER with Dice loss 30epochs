n.Sigmoid()\n        )\n    def forward(self, g, x):\n        g1 = self.W_g(g)\n        x1 = self.W_x(x)\n        psi = self.psi(g1 + x1)\n        return x * psi\n\n# --- AER Block ---\nclass AERBlock(nn.Module):\n    def __init__(self, in_channels):\n        super().__init__()\n        self.residual_path = nn.Sequential(\n            nn.Conv2d(in_channels, in_channels, kernel_size=3, padding=1),\n            nn.ReLU(inplace=True),\n            nn.Conv2d(in_channels, in_channels, kernel_size=3, padding=1),\n            nn.ReLU(inplace=True)\n        )\n        self.down = nn.Conv2d(in_channels, in_channels // 2, kernel_size=3, stride=2, padding=1)\n        self.mid = nn.Sequential(\n            nn.ReLU(inplace=True),\n            nn.Conv2d(in_channels // 2, in_channels // 2, kernel_size=3, padding=1),\n            nn.ReLU(inplace=True),\n            nn.Conv2d(in_channels // 2, in_channels, kernel_size=3, padding=1)\n        )\n        self.sigmoid = nn.Sigmoid()\n    def forward(self, x):\n        res = self.residual_path(x)\n        attn = self.down(x)\n        attn = self.mid(attn)\n        attn = F.interpolate(attn, size=x.shape[2:], mode='bilinear', align_corners=False)\n        attn = self.sigmoid(attn)\n        return res + x * attn\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-07-26T08:41:44.108206Z","iopub.execute_input":"2025-07-26T08:41:44.108463Z","iopub.status.idle":"2025-07-26T08:41:44.122167Z","shell.execute_reply.started":"2025-07-26T08:41:44.108441Z","shell.execute_reply":"2025-07-26T08:41:44.121541Z"}},"outputs":[],"execution_count":8},{"cell_type":"code","source":"# %% [code]\n# -- Vanilla U-Net\nclass VanillaUNet(nn.Module):\n    def __init__(self):\n        super().__init__()\n        self.enc1 = UNetBlock(3, 32)\n        self.pool1 = nn.MaxPool2d(2)\n        self.enc2 = UNetBlock(32, 64)\n        self.pool2 = nn.MaxPool2d(2)\n        self.enc3 = UNetBlock(64, 128)\n        self.pool3 = nn.MaxPool2d(2)\n        self.bottlen