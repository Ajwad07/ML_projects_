ce_loss(pred, target, smooth=1e-6):\n    pred = pred.view(pred.size(0), -1)\n    target = target.view(target.size(0), -1)\n    intersection = (pred * target).sum(dim=1)\n    union = pred.sum(dim=1) + target.sum(dim=1)\n    dice = (2. * intersection + smooth) / (union + smooth)\n    return 1 - dice.mean()\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-07-26T08:41:44.122859Z","iopub.execute_input":"2025-07-26T08:41:44.123056Z","iopub.status.idle":"2025-07-26T08:41:44.139724Z","shell.execute_reply.started":"2025-07-26T08:41:44.123040Z","shell.execute_reply":"2025-07-26T08:41:44.139157Z"}},"outputs":[],"execution_count":9},{"cell_type":"markdown","source":"# %% [markdown]\n# ## 6. Choose Model and Loss\n# - To switch models, just change the assignment in the first line below.\n# - To switch loss, comment/uncomment as needed.\n","metadata":{}},{"cell_type":"markdown","source":"AER_unet with bceloss\n","metadata":{}},{"cell_type":"code","source":"# %% [code]\n# --- CHOOSE MODEL ---\n# model = VanillaUNet().to(device)\n# model = AttnUNet().to(device)\nmodel_are_unet_bce = AER_UNet().to(device)   # <<--- Change to run other models\n\n# --- CHOOSE LOSS ---\ncriterion = nn.BCELoss()                      # BCE only\n# criterion = lambda pred, mask: nn.BCELoss()(pred, mask) + dice_loss(pred, mask)   # BCE + Dice\noptimizer = optim.Adam(model_are_unet_bce.parameters(), lr=0.001)\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-07-26T07:36:44.327946Z","iopub.execute_input":"2025-07-26T07:36:44.328192Z","iopub.status.idle":"2025-07-26T07:36:44.537073Z","shell.execute_reply.started":"2025-07-26T07:36:44.328173Z","shell.execute_reply":"2025-07-26T07:36:44.536468Z"}},"outputs":[],"execution_count":13},{"cell_type":"code","source":"# %% [code]\nfor epoch in range(10):\n    model_are_unet_bce.train()\n    total_loss = 0\n    for img, mask in tqdm(train_loader):\n        img, mask = img.to(device), mask.to(device)\n        pred = model_are_unet_